@model IEnumerable<WesternVilla.Models.Resident>
@{
    ViewData["Title"] = "Registration Report Dashboard / નોંધણી અહેવાલ";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f8fafc;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Header -->
        <div class="md:flex md:items-center md:justify-between mb-10">
            <div class="flex-1 min-w-0">
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl bg-clip-text text-transparent bg-gradient-to-r from-teal-600 to-blue-700">
                    Society Community Report / સોસાયટી અહેવાલ
                </h1>
                <p class="mt-2 text-sm text-slate-500 font-medium">
                    Manage and export registered resident data, family members, vehicles, and maintenance details.
                </p>
            </div>
            <div class="mt-4 flex md:mt-0 md:ml-4 space-x-3">
                <!-- Export to Excel Button -->
                <a asp-action="ExportExcel" class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white text-sm font-bold rounded-2xl shadow-sm transition duration-200 hover:-translate-y-0.5">
                    <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Export Excel / એક્સેલ ડાઉનલોડ</span>
                </a>

                <!-- Register New Button -->
                <a asp-controller="Registration" asp-action="Index" class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white text-sm font-bold rounded-2xl shadow-sm transition duration-200 hover:-translate-y-0.5">
                    <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                    <span>Add New / નવું ઉમેરો</span>
                </a>
            </div>
        </div>

        <!-- Dashboard Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Registered Homes / કુલ ઘર</div>
                <div class="text-3xl font-extrabold text-slate-800 mt-2">@Model.Count()</div>
            </div>
            
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Rented Homes (Tenants) / ભાડુઆત ઘર</div>
                <div class="text-3xl font-extrabold text-blue-600 mt-2">@Model.Count(r => r.IsTenant == "Yes")</div>
            </div>

            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Maintenance Paid / ભરેલ મેન્ટેનન્સ</div>
                <div class="text-3xl font-extrabold text-emerald-600 mt-2">@Model.Count(r => r.IsMaintenancePaid == "Yes")</div>
            </div>

            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Vehicles Registered / કુલ વાહનો</div>
                <div class="text-3xl font-extrabold text-amber-600 mt-2">@Model.Sum(r => r.Vehicles?.Count ?? 0)</div>
            </div>
        </div>

        <!-- Mobile Card Layout (Visible on mobile only) -->
        <div class="grid grid-cols-1 gap-6 md:hidden">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-md relative hover:shadow-lg transition">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-xs font-extrabold text-slate-400 uppercase tracking-wider">House No: @item.HouseNumber</span>
                                <h3 class="text-lg font-bold text-slate-800 mt-1">
                                    @if (item.IsTenant == "Yes")
                                    {
                                        <span>@item.TenantFirstName @item.TenantSurName</span>
                                    }
                                    else
                                    {
                                        <span>@item.OwnerFirstName @item.OwnerSurName</span>
                                    }
                                </h3>
                            </div>
                            <div>
                                @if (item.IsMaintenancePaid == "Yes")
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                        Paid / ચૂકવેલ
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-100">
                                        Unpaid / બાકી
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="mt-4 space-y-2 text-sm text-slate-600">
                            <div>
                                <span class="font-bold text-slate-500 text-xs">Resident Type / રહેવાસી:</span>
                                @if (item.IsTenant == "Yes")
                                {
                                    <span class="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-semibold border border-blue-100">Tenant / ભાડુઆત</span>
                                    <div class="text-xs text-slate-400 mt-1 pl-4">Owner: @item.OwnerFirstName @item.OwnerSurName</div>
                                }
                                else
                                {
                                    <span class="text-xs bg-slate-50 text-slate-600 px-2 py-0.5 rounded font-semibold border border-slate-200">Owner / માલિક</span>
                                }
                            </div>
                            <div><span class="font-bold text-slate-500 text-xs">Mobile / મોબાઇલ:</span> @item.MobileNumber</div>
                            <div><span class="font-bold text-slate-500 text-xs">Email / ઇમેઇલ:</span> @item.Email</div>
                            @if (item.IsMaintenancePaid == "Yes" && item.IsReceiptReceived == "Yes")
                            {
                                <div><span class="font-bold text-slate-500 text-xs">Receipt / રસીદ:</span> @item.ReceiptNumber</div>
                            }
                            <div class="flex justify-between text-xs text-slate-400 mt-4 border-t border-slate-100 pt-3">
                                <span>Family Size: @(item.FamilyMembers?.Count ?? 0)</span>
                                <span>Vehicles: @(item.Vehicles?.Count ?? 0)</span>
                            </div>
                        </div>

                        <div class="mt-5 pt-4 border-t border-slate-100">
                            <a asp-action="DownloadWord" asp-route-id="@item.Id" class="w-full text-center inline-flex justify-center items-center px-4 py-2.5 bg-blue-50 border border-blue-100 text-blue-700 hover:bg-blue-100 rounded-xl text-xs font-bold transition">
                                <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                <span>Word File / ડાઉનલોડ</span>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-white text-center py-12 px-6 border border-slate-100 rounded-3xl text-sm text-slate-400 font-medium shadow-sm">
                    No registrations found. Register a resident to see them here. / કોઈ રજીસ્ટ્રેશન મળ્યું નથી.
                </div>
            }
        </div>

        <!-- Desktop Table Layout (Visible on medium screens and larger) -->
        <div class="hidden md:block bg-white shadow-xl rounded-3xl overflow-hidden border border-slate-100">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-100">
                    <thead class="bg-slate-50">
                        <tr>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">
                                House No / ઘર નંબર
                            </th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">
                                Primary Resident (Owner / Tenant) / મુખ્ય રહેવાસી
                            </th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">
                                Contact details / સંપર્ક વિગત
                            </th>
                            <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">
                                Maint. Status / મેન્ટેનન્સ
                            </th>
                            <th scope="col" class="px-6 py-4 text-center text-xs font-bold text-slate-500 uppercase tracking-wider">
                                Family Size / સભ્યો
                            </th>
                            <th scope="col" class="px-6 py-4 text-center text-xs font-bold text-slate-500 uppercase tracking-wider">
                                Vehicles / વાહનો
                            </th>
                            <th scope="col" class="relative px-6 py-4 text-right text-xs font-bold text-slate-500 uppercase tracking-wider">
                                Actions / ડાઉનલોડ
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="hover:bg-slate-50/50 transition">
                                    <!-- House Number -->
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-extrabold text-slate-900">
                                        @item.HouseNumber
                                    </td>
                                    
                                    <!-- Primary Resident (Name of Tenant or Owner) -->
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-semibold text-slate-800">
                                            @if (item.IsTenant == "Yes")
                                            {
                                                <span>@item.TenantFirstName @item.TenantSurName</span>
                                            }
                                            else
                                            {
                                                <span>@item.OwnerFirstName @item.OwnerSurName</span>
                                            }
                                        </div>
                                        <div class="text-xs text-slate-400 mt-0.5">
                                            @if (item.IsTenant == "Yes")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                                    Tenant / ભાડુઆત (Owner: @item.OwnerFirstName @item.OwnerSurName)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-50 text-slate-600 border border-slate-200">
                                                    Owner / માલિક
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Contact details -->
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                                        <div class="font-medium">@item.MobileNumber</div>
                                        <div class="text-xs text-slate-400 mt-0.5">@item.Email</div>
                                    </td>

                                    <!-- Maintenance Paid status -->
                                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                                        @if (item.IsMaintenancePaid == "Yes")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                                Paid / ચૂકવેલ
                                            </span>
                                            @if (item.IsReceiptReceived == "Yes")
                                            {
                                                <span class="block text-xs text-slate-400 mt-1">Rec No: @(item.ReceiptNumber ?? "-")</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-100">
                                                Unpaid / બાકી
                                            </span>
                                        }
                                    </td>

                                    <!-- Family Size -->
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-semibold text-slate-700">
                                        @(item.FamilyMembers?.Count ?? 0)
                                    </td>

                                    <!-- Vehicles count -->
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-semibold text-slate-700">
                                        @(item.Vehicles?.Count ?? 0)
                                    </td>

                                    <!-- Action (Word File download) -->
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <a asp-action="DownloadWord" asp-route-id="@item.Id" class="inline-flex items-center px-3.5 py-1.5 bg-blue-50 border border-blue-100 text-blue-700 hover:bg-blue-100 rounded-xl text-xs font-bold transition duration-150">
                                            <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                            <span>Word File / ડાઉનલોડ</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center text-sm text-slate-400 font-medium">
                                    No registrations found. Register a resident to see them here. / કોઈ રજીસ્ટ્રેશન મળ્યું નથી.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
