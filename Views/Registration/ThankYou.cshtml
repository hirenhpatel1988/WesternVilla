@{
    ViewData["Title"] = "Thank You / આભાર";
    var successMsg = TempData["SuccessMessage"] as string ?? "Registration Submitted Successfully / નોંધણી સફળતાપૂર્વક પૂર્ણ થઈ";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f8fafc;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl border border-slate-100 p-8 text-center animate-fade-in">
        
        <!-- Checkmark Icon -->
        <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-emerald-100 text-emerald-600 mb-6 shadow-sm">
            <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-2">
            Thank You! / આભાર!
        </h1>
        
        <p class="text-sm font-semibold text-emerald-700 bg-emerald-50 py-2.5 px-4 rounded-xl mb-4 border border-emerald-100">
            @successMsg
        </p>

        <p class="text-sm text-slate-500 mb-8 leading-relaxed">
            Your details have been saved in the society directory. You may now safely close this browser window. / તમારી વિગતો સોસાયટી ડાયરેક્ટરીમાં સેવ થઈ ગઈ છે.
        </p>

        <!-- Action Buttons -->
        <div class="space-y-3">
            <button onclick="closeWindow()" type="button" class="w-full py-3 px-6 bg-gradient-to-r from-blue-700 to-indigo-600 hover:from-blue-800 hover:to-indigo-700 text-white font-bold rounded-2xl shadow-md transition duration-200 transform hover:-translate-y-0.5 flex items-center justify-center space-x-2">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>Close Window / બારી બંધ કરો</span>
            </button>

            <a asp-controller="Registration" asp-action="Index" class="block w-full py-2.5 px-6 text-slate-500 hover:text-slate-700 font-semibold text-xs rounded-xl hover:bg-slate-50 transition">
                Register Another Home / બીજું ફોર્મ ભરો
            </a>
        </div>
    </div>

    <script>
        function closeWindow() {
            window.opener = null;
            window.open('', '_self');
            window.close();
            // Fallback if browser blocks automatic window.close
            setTimeout(() => {
                alert("If the window does not close automatically, please close this tab manually. / કૃપા કરીને આ ટેબ હાથેથી બંધ કરો.");
            }, 500);
        }
    </script>
</body>
</html>
